[Unit]
Description=SocTalk first-boot setup wizard (collects config, exits)
# Start on a normal boot via multi-user.target. This unit MUST NOT be
# WantedBy=cloud-init.target: on an OVA deploy with no cloud-init datasource
# (the normal ESXi/vSphere case) cloud-init disables itself, cloud-init.target
# never activates, and a WantedBy=cloud-init.target unit would never start —
# the wizard would never bind :8443. `After=cloud-init.target` is ordering
# ONLY (it has no effect when the target isn't in the transaction, so it can't
# reintroduce the historical WantedBy=multi-user + After=cloud-final cycle):
# when cloud-init IS present it still lets a cloud-init-supplied values.yaml
# land before our ConditionPathExists checks; when it's absent it's a no-op.
After=cloud-init.target network-online.target
Wants=network-online.target
# Skip entirely on any subsequent boot once a sentinel exists OR
# values.yaml is already present.
ConditionPathExists=!/var/lib/soctalk-firstboot.done
ConditionPathExists=!/var/lib/soctalk-wizard.done
ConditionPathExists=!/etc/soctalk/values.yaml

[Service]
Type=simple
ExecStart=/usr/local/bin/soctalk-setup-wizard
Restart=on-failure
RestartSec=10
StandardOutput=journal+console
StandardError=journal+console

# Hardening (codex review: be explicit, not handwave).
# We need root because we write to /etc/soctalk and /var/lib, but we
# don't need most capabilities.
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_DAC_OVERRIDE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# We need to write these specific paths.
ReadWritePaths=/etc/soctalk /var/log /var/lib/soctalk-wizard /var/lib
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true

TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
