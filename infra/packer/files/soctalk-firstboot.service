[Unit]
Description=SocTalk first-boot setup (k3s + helm install)
# Start on a normal boot via multi-user.target. Same two constraints as the
# wizard unit: MUST NOT be WantedBy=cloud-init.target (never starts on a
# no-datasource OVA deploy) and MUST NOT order After=cloud-init.target while
# WantedBy=multi-user.target (forms a multi-user ⇄ cloud-init ordering cycle
# that systemd breaks by deleting this job). We therefore do NOT reference
# cloud-init.target. Ordering after cloud-init to let a cloud-init-supplied
# values.yaml land first is NOT needed here: firstboot.sh polls for
# values.yaml + llm.key itself (from cloud-init OR the wizard) with the unit
# at TimeoutStartSec=infinity, so it waits regardless of start order.
After=soctalk-setup-wizard.service network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/soctalk-firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/soctalk-firstboot
RemainAfterExit=true
StandardOutput=journal+console
StandardError=journal+console
# No systemd start-timeout: this unit spends most of its time WAITING for the
# operator to finish the browser setup wizard (soctalk-setup-wizard.service is
# itself TimeoutStartSec=infinity — human-paced), then runs the k3s + helm
# install (helm has its own --wait --timeout). A fixed 20m start-timeout was
# SHORTER than firstboot.sh's own wait budget, so on slow/nested hardware
# systemd killed this unit mid-wait before the wizard was even submitted,
# leaving k3s up but SocTalk uninstalled. Let the script's internal budget +
# helm's timeout be the real gates.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
